# ==============================================================================
# FNMF Backend Test Environment Configuration Template
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành '.env.test' (file này đã được .gitignore bỏ qua).
# 2. Điền thông tin kết nối Database thử nghiệm (PostgreSQL cục bộ hoặc trên Note10+).
# 3. Tuyệt đối KHÔNG sử dụng thông tin kết nối cơ sở dữ liệu Railway Production.
# ==============================================================================

PORT=8083

# Cấu hình CSDL PostgreSQL thử nghiệm độc lập
TEST_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fnmf_test
TEST_DATASOURCE_USERNAME=fnmf_test_user
TEST_DATASOURCE_PASSWORD=fnmf_test_password
TEST_FLYWAY_ENABLED=false

# Secret khóa JWT cho môi trường thử nghiệm
TEST_JWT_SECRET=isolated_test_jwt_secret_key_minimum_256_bits_for_hmac_sha256_algorithm
TEST_JWT_EXPIRATION_MS=86400000

# Mock / Sandbox Keys cho dịch vụ ngoài
TEST_ALPHAVANTAGE_API_KEY=DEMO_TEST_KEY
TEST_ALPHAVANTAGE_API_URL=https://www.alphavantage.co/query
TEST_OPENAI_API_KEY=MOCK_TEST_GEMINI_KEY
TEST_OPENAI_DEFAULT_MODEL=gemini-3.6-flash

# Cổng thanh toán Sandbox nội bộ
PAYMENT_PROVIDER=SANDBOX_INTERNAL
