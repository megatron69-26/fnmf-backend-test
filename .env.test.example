# ==============================================================================
# FNMF Backend Test Environment Configuration Template (.env.test)
# ==============================================================================
# HƯỚNG DẪN BẢO MẬT:
# 1. Sao chép file này thành '.env.test' trên thiết bị Note10+ hoặc máy trạm test.
# 2. File '.env.test' đã được .gitignore chặn hoàn toàn, tuyệt đối KHÔNG commit lên Git.
# 3. Môi trường test hoạt động theo nguyên tắc FAIL-CLOSED:
#    - TEST_DATASOURCE_PASSWORD và TEST_JWT_SECRET là bắt buộc.
#    - Nếu không cung cấp, server sẽ dừng khởi động để bảo đảm an toàn.
# ==============================================================================

PORT=8083

# 1. Cơ sở dữ liệu PostgreSQL cục bộ trên Note 10+ (chỉ lắng nghe 127.0.0.1)
TEST_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/fnmf_test
TEST_DATASOURCE_USERNAME=fnmf_test_user
TEST_DATASOURCE_PASSWORD=nhap_mat_khau_database_test_ngau_nhien_tai_day

# 2. Schema Management
TEST_FLYWAY_ENABLED=true
TEST_DDL_AUTO=validate

# 3. Secret khóa ký JWT (Tối thiểu 32 ký tự / 256 bits ngẫu nhiên độc lập)
TEST_JWT_SECRET=nhap_chuoi_khoa_jwt_test_ngau_nhien_it_nhat_32_ky_tu_tai_day
TEST_JWT_EXPIRATION_MS=86400000

# 4. API Dịch vụ bên ngoài (Để trống nếu không có key thật, hệ thống sẽ báo không khả dụng)
TEST_ALPHAVANTAGE_API_KEY=
TEST_OPENAI_API_KEY=
TEST_OPENAI_DEFAULT_MODEL=gemini-3.6-flash

# 5. Swagger UI (Tắt mặc định để bảo mật khi mở tunnel)
TEST_SWAGGER_ENABLED=false

# 6. Cổng thanh toán Sandbox nội bộ
PAYMENT_PROVIDER=SANDBOX_INTERNAL
